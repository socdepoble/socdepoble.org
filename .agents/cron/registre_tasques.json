{
  "$comment": "DESTÍ: .agents/cron/registre_tasques.json (en quarantena al laboratori fins que el Mestre el copie). Canvis: les cinc tasques de Plaquetes declaren que les llança plaquetes-diagnostic (llancador.tipus = tasca) i hereten la seua cadència; reflex-daemon desapareix perquè el plist es desinstal·la (l'script mai ha existit); es declaren els altres passos del pre-commit i el post-commit perquè el Calendari veja tota la cadena de hooks de git.",
  "plaquetes": [
    {
      "id": "higiene-basica",
      "descripcio": "Esborra fitxers temporals (.orig, .rej, ~, .DS_Store) i directoris orfes sense sentit.",
      "nivell": "L0",
      "idempotent": true,
      "pressupost_ms": 5000,
      "fusible": {
        "max_ko_consecutius": 3
      },
      "llancador": { "tipus": "tasca", "tasca": "plaquetes-diagnostic" }
    },
    {
      "id": "adopta-orfes",
      "descripcio": "Afegeix automàticament els orfes a l'Índex d'adopció (00_INDEX.md).",
      "nivell": "L1",
      "idempotent": true,
      "pressupost_ms": 10000,
      "fusible": {
        "max_ko_consecutius": 2
      },
      "llancador": { "tipus": "tasca", "tasca": "plaquetes-diagnostic" }
    },
    {
      "id": "lapida-fantasmes",
      "descripcio": "Tanca els enllaços cap a fitxers inexistents i els envia al Memorial.",
      "nivell": "L2",
      "idempotent": true,
      "pressupost_ms": 15000,
      "fusible": {
        "max_ko_consecutius": 2
      },
      "llancador": { "tipus": "tasca", "tasca": "plaquetes-diagnostic" }
    },
    {
      "id": "quarantena-brossa",
      "descripcio": "Mou a quarantena els fitxers sense extenció o que pareixen trencats/buits.",
      "nivell": "L2",
      "idempotent": true,
      "pressupost_ms": 15000,
      "fusible": {
        "max_ko_consecutius": 2
      },
      "llancador": { "tipus": "tasca", "tasca": "plaquetes-diagnostic" }
    },
    {
      "id": "refresc-tokens",
      "descripcio": "Comprova i refresca els tokens d'accés abans de caducar.",
      "nivell": "L1",
      "idempotent": true,
      "pressupost_ms": 5000,
      "fusible": {
        "max_ko_consecutius": 3
      },
      "llancador": { "tipus": "tasca", "tasca": "plaquetes-diagnostic" }
    }
  ],
  "tasques": [
    {
      "id": "plaquetes-diagnostic",
      "descripcio": "Diagnòstic horari de Plaquetes: diagnostica i no aplica mai. Executa les cinc tasques de la llista plaquetes.",
      "llancador": { "tipus": "launchd", "etiqueta": "org.socdepoble.plaquetes" },
      "cadencia": { "cada_segons": 3600, "en_arrencar": true },
      "script": "scripts/immunitari/plaquetes.mjs",
      "arguments": ["diagnostic", "--autonom"],
      "llig": ["_wiki_de_poble/"],
      "escriu": [".immunitari/receptes/", ".immunitari/cron.out"],
      "registre": ".immunitari/cron.out",
      "nivell": "L0"
    },
    {
      "id": "time-machine",
      "descripcio": "Instantània del treball a refs/time-machine/<branca> si l'arbre ha canviat.",
      "llancador": { "tipus": "launchd", "etiqueta": "org.socdepoble.time-machine" },
      "cadencia": { "cada_segons": 1800, "en_arrencar": true },
      "script": "tooling/brain/time-machine.mjs",
      "arguments": [],
      "llig": ["."],
      "escriu": [".git/time-machine.index", "refs/time-machine/"],
      "registre": "~/Library/Logs/socdepoble-time-machine.log",
      "nivell": "L0"
    },
    {
      "id": "frontissa-contingut",
      "descripcio": "Primer pas del pre-commit: les claus estructurals de PAGE_COPY existixen i tenen empremta aprovada.",
      "llancador": { "tipus": "git-hook", "esdeveniment": "pre-commit" },
      "script": "tooling/gates/frontissa-contingut.mjs",
      "arguments": [],
      "nivell": "L0"
    },
    {
      "id": "porta-taxonomia",
      "descripcio": "Pre-commit: els fitxers nous de l'Escriptori i de les actes seguixen aammdd_hhmm_categoria_titol.ext.",
      "llancador": { "tipus": "git-hook", "esdeveniment": "pre-commit" },
      "script": "tooling/gates/porta-taxonomia.mjs",
      "arguments": ["--staged"],
      "nivell": "L0"
    },
    {
      "id": "porta-plantilla-viva",
      "descripcio": "Pre-commit: els documents en stage ixen de la plantilla viva i no d'una còpia rància.",
      "llancador": { "tipus": "git-hook", "esdeveniment": "pre-commit" },
      "script": "tooling/gates/porta-plantilla-viva.mjs",
      "arguments": ["--staged"],
      "nivell": "L0"
    },
    {
      "id": "git-staged",
      "descripcio": "Últim pas del pre-commit: cadena de portes sobre els fitxers en stage.",
      "llancador": { "tipus": "git-hook", "esdeveniment": "pre-commit" },
      "script": "tooling/gates/git-staged.mjs",
      "arguments": [],
      "nivell": "L0"
    },
    {
      "id": "reflex-consume-commit",
      "descripcio": "Post-commit: consumix el commit dins del Reflex de Petorretes (rebuts i leases).",
      "llancador": { "tipus": "git-hook", "esdeveniment": "post-commit" },
      "script": "tooling/wiki/reflex_petorreta.mjs",
      "arguments": ["consume-commit"],
      "nivell": "L0"
    }
  ]
}
