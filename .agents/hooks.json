{
  "preflight-matrix": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/preflight_matrix_wrapper.mjs"
          }
        ]
      }
    ]
  },
  "trellat-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|create_directory|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/verify.mjs"
          }
        ]
      }
    ]
  }
}
