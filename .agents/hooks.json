{
  "description": "Configuració declarativa; consumidor Antigravity no acreditat. Cap garantia d’activació.",
  "hooks": [
    {
      "event": "PreToolUse",
      "toolNames": [
        "write_to_file",
        "replace_file_content",
        "multi_replace_file_content",
        "run_command"
      ],
      "command": "node tooling/gates/hooks-local.mjs"
    },
    {
      "event": "PostToolUse",
      "toolNames": [
        "write_to_file",
        "replace_file_content",
        "multi_replace_file_content",
        "run_command"
      ],
      "command": "node tooling/gates/segell-auto.mjs"
    }
  ]
}
