{
  "sdp-olivera": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "cd .. && node tooling/gates/antigravity-hook.mjs pre-invocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd .. && node tooling/gates/antigravity-hook.mjs pre-tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
