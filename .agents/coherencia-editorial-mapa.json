  "lexicProhibit": [
    {
      "id": "LEX-01",
      "patro": "\\bIAIA\\s+(?:sobirana|soberana|sovereign|burujabea?)\\b",
      "motiu": "Llei 0: la IAIA no es proclama «sobirana»; es descriu pel seu motor real."
    },
    {
      "id": "LEX-02",
      "patro": "\\bWhatsApp\\s+(?:sobir[àa]|soberano|sovereign|burujabea?)\\b",
      "motiu": "Llei 0: el Xat és missatgeria comunitària; el xifratge d'extrem a extrem és al codi però apagat per bandera compilada (E2EE_ACTIU_PER_DEFECTE = false). Mai «WhatsApp sobirà»."
    },
    {
      "id": "LEX-03",
      "patro": "\\bNode\\s*0\\s+(?:sobir[àa]|soberano|burujabea?)\\b|\\bSovereign\\s+Node\\s*0\\b|\\bMagatzem\\s+sobir[àa]\\b",
      "motiu": "Llei 0: el Node 0 és un servidor comunitari pilot (Mac mini M4), no «Node 0 sobirà»."
    },
    {
      "id": "LEX-04",
      "patro": "\\bApple\\s+Silicon\\b",
      "motiu": "Llei 0: evitar marquisme promocional «Apple Silicon»; dir «xip Apple M4» o «processador ARM local»."
    },
    {
      "id": "LEX-05",
      "patro": "\\bcategoria\\s+Pilar\\b",
      "motiu": "Taxonomia vigent: la categoria «Pilar» fou retirada."
    }
  ],
