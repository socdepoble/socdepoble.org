{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socdepoble.org/schemas/wiki-frontmatter-v2.1.json",
  "title": "Frontmatter can\u00f2nic de la Wiki de S\u00f3c de Poble",
  "description": "\u00danica font mec\u00e0nica de veritat per a les metadades Markdown de la Wiki.",
  "$comment": "S'aplica a contingut propi; mirrors i vendors conserven el seu contracte i s\u00f3n immutables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "status",
    "description"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "acta",
        "briefing",
        "document",
        "hub",
        "index",
        "informe",
        "norma",
        "plantilla",
        "prompt",
        "protocol",
        "registre",
        "skill",
        "petorreta"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "canonic",
        "actiu",
        "esborrany",
        "arxivat",
        "quarantena",
        "generat",
        "futur"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 12,
      "maxLength": 220
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "maxItems": 5,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "core",
          "govern",
          "saber",
          "maquina",
          "identitat",
          "genoma",
          "arquitectura",
          "disseny",
          "escriptori",
          "legal",
          "consell",
          "acta",
          "revisar",
          "ser",
          "sollutia",
          "temporal",
          "skills",
          "plantilla",
          "pla",
          "graf",
          "fortificacio",
          "supabase",
          "portes",
          "auditoria",
          "brain",
          "trellat",
          "codex",
          "aprenentatge",
          "tractors",
          "marmota",
          "acta-marmota",
          "coneixement",
          "log",
          "seguretat",
          "implementacio",
          "col·laboració",
          "memòria",
          "rols",
          "reflex",
          "abocament"
        ]
      },
      "uniqueItems": true
    },
    "name": {
      "type": "string"
    },
    "triggers_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core": {
      "type": "boolean"
    },
    "prioritat": {
      "type": "integer"
    },
    "version": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "eines_obligatories": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "reflex": {
      "type": "string"
    },
    "contracte.llig": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*90_arxiu_historic)\\S+$"
      },
      "uniqueItems": true
    }
  }
}