{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-gate.schema.json",
  "title": "Configuració d'una porta de coherència",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "targets", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "canonical_requirement": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\." }
    },
    "ignore_directories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "ignore_file_patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ignore_path_patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inactive_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "max_file_bytes": { "type": "integer", "minimum": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "message"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]+$" },
          "pattern": { "type": "string", "minLength": 1 },
          "flags": { "type": "string", "pattern": "^[dimsuvy]*$" },
          "severity": { "enum": ["error", "warning"] },
          "message": { "type": "string", "minLength": 1 },
          "path_allow": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "path_deny": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
