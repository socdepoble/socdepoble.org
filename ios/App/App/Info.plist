	<array>
		<string>ca</string>
		<string>es</string>
		<string>en</string>
		<string>eu</string>
		<string>gl</string>
	</array>
	<key>CFBundleName</key>
	<string>Sóc de Poble</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
