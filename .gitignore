node_modules
dist
# Cache privada dels clons amb dependències enllaçades; es reconstruïx sola.
/.sdp-vite-cache/
# Carpeta antiga de paquets (buida). wordpress-plugin/eines/empaqueta.mjs escriu a wordpress-plugin/builds/
# (destinació única, skill core-empaquetat-wp), i els *.zip queden fora per la regla de més avall.
/release/
.DS_Store
.DS-Store
*DS_Store*
*DS-Store*
._*
*.log
.sdp-reflex/
.wiki-safety/
_build/
.snapshots/
.firebase/
.env
.env.*
!.env.example
_wiki_de_poble/.obsidian/workspace*.json
_wiki_de_poble/.obsidian/cache/
.iaia_auth/
.wwebjs_auth/
*.stale-*
bot/var/
var/
.frontmatter-copia-*

# Artefactes derivats del cervell: es reconstruïxen sols (build_skills_index.mjs)
# i la traça del resegellat automàtic, que és local a la màquina.
.agents/skills_index.json
.agents/runtime/segell.log

# Evidència documental durable; només locks i punters locals queden fora.
.agents/runtime/*.lock
.agents/runtime/turns/*.lock
.agents/runtime/turns/*.tmp
.agents/runtime/torn_actiu*.json
# Interruptor d'apagada del hook d'Antigravity (tooling/gates/antigravity-hook.mjs): és local i del Mestre.
# La seua traça, .agents/runtime/antigravity-hook.log, ja queda fora per *.log.
.agents/runtime/antigravity-hook.off
*.zip
# Ordre del Mestre (261021, prompt 261021_0015, tasca 2) · L'APK de prova dels
# beta testers (01_produccio/socdepoble-beta.apk, 51 MB) es lliura, no es versiona.
*.apk
# Ordre del Mestre (261031, Ronda 1) · .claude/settings.json porta els ganxos del
# projecte i és un fitxer crític del Reflex (CRITICAL_SEED_PATHS): es versiona.
# La resta de .claude/ (settings.local.json, launch.json, enllaços de skills) és local.
**/.claude/*
!/.claude/settings.json

# Ordre del Mestre (261002) · Fora del repositori: els guions de prova de
# l'arrel, l'estat local de la CLI de Supabase (porta secrets de l'edge runtime
# a docker.env) i la còpia de la CLI que ha deixat el plugin de WordPress.
# Ignorar no desversiona: el que ja és a l'índex (scratch/, supabase/.temp/,
# supabase/.branches/) ho ha de retirar el Mestre.
/scratch/
supabase/.temp/
supabase/.branches/
wordpress-plugin/supabase/
docker.env



# Cron d'higiene (261009) i Plaquetes: informes, registres i receptes són estat local de la màquina.
# Ignorar no desversiona: el que ja és a l'índex (receptes, cron.out, cron.err) ho retira el Mestre
# amb git rm --cached (INVENTARI_BROSSA del laboratori 261009_0400_higiene_claude).
.immunitari/higiene/
.immunitari/higiene-cron.out
.immunitari/higiene-cron.err
.immunitari/cron.out
.immunitari/cron.err
.immunitari/receptes/
# Quarantenes del circuit (cron_higiene.mjs i neteja_brossa_arrel.mjs): el que s'hi mou no torna a
# entrar a git per una altra ruta. Les quarantenes que ja són a l'índex hi continuen (INVENTARI §3.5).
/.sdp-paperera/quarantena-*/
# App nativa (Fase C, Capacitor 8): eixides de build i claus, mai al repositori.
# Proposta de FASE_PRELEASE_FETA.txt §6 (laboratori 261003_1330_empaquetat_mobil_claude).
/dist-natiu/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/DerivedData/
*.jks
*.keystore
keystore.properties
*.p8
*.p12
*.cer
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Registre local: mai dades de sessió al control de versions.
/.agents/runtime/antigravity-hook.log

# R10: version only direct lifecycle receipts; all other runtime is local.
/.agents/runtime/*
!/.agents/runtime/turns/
!/.agents/runtime/contracts/
/.agents/runtime/turns/*
!/.agents/runtime/turns/*.json
/.agents/runtime/contracts/*
!/.agents/runtime/contracts/*.json

# Ordre del Mestre 261109 · R15a · Fotos i captures que no es versionen mai.
# Fotos locals de La Parròquia: només per a builds opt-in
# (VITE_SDP_BAR_LLAVOR_LA_PARROQUIA=1), mai al repositori públic. Porten GPS,
# metadades de tercers i drets reservats d'agències i de marques. El manifest
# (src/data/menjarIBeure/parroquiaFotos.generated.json) sí que es versiona.
/src/assets/bar/parroquia/
# Originals del Pou de Neu amb GPS: les versions netes ja són a src/.
/_wiki_de_poble/90_arxiu_historic/2026-11/08/
# Captures amb dades personals: no es versionen.
/_wiki_de_poble/04_escriptori/01_produccio/261107_1615_captura_supabase_sessions_origen_entrada_reals.jpg
/_wiki_de_poble/04_escriptori/01_produccio/261108_1406_captura_notes_enganxar_text_brut_h1_entradilla_cos_netejar_format.jpg
# Sanejament R15 (P0, 261109) · Captures amb dades personals de tercers (noms,
# usuaris, correus, xats): no es versionen mai. Les 11 de 261106 (commit
# 6a444026a) ixen de l'índex amb `git rm --cached` i es queden al disc del
# Mestre; purgar-les de l'historial publicat és decisió seua.
/_wiki_de_poble/**/*captura_supabase*
/_wiki_de_poble/**/*captura_google_groups*
/_wiki_de_poble/**/*captura_languagetool*
/_wiki_de_poble/**/*captura_whatsapp*
/_wiki_de_poble/**/*usuaris_reals*
# Sanejament R15 (PRIV-06, 261109) · La instantània completa de La Parròquia
# (preus de compra per pack, recàrrec d'equivalència i cel·les d'origen amb
# costos, marges i fórmules) només en local, per als builds opt-in i DEV. Al
# repositori va parroquiaDades.generated.json, la versió sense eixos camps.
/src/data/menjarIBeure/parroquiaDades.privat.json

# R15.2: els originals locals no ixen al build públic.
/public/assets/uploads/tpv-parroquia/

# Sanejament R15b (privadesa, 261109) · Les captures de WhatsApp-Clon-01 i -02
# mostren xats, contactes, telèfons i grups privats de terceres persones: 63
# ixen de l'índex amb `git rm --cached` i es queden al disc del Mestre. Només
# continuen versionades les 11 revisades com a aptes o dubtoses (decisió del
# Mestre). Purgar l'historial publicat també és decisió seua.
/_wiki_de_poble/04_escriptori/01_produccio/WhatsApp-Clon-01/*
/_wiki_de_poble/04_escriptori/01_produccio/WhatsApp-Clon-02/*
