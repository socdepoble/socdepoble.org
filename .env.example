# ======= FRONTEND & SUPABASE =======
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_DATA_MODE=auto

# ======= TELEMETRIA POCA-SOLTA (UMAMI) =======
# Opcionals i públiques (van dins del bundle). Sense un ID i un HOST vàlids no
# s'envia res: src/data/telemetria.js envia per fetch a <HOST>/api/send, sense
# cap script de fora (la CSP és script-src 'self'). Respecta DNT i GPC.
# ID del lloc («website») a Umami: un UUID.
VITE_UMAMI_WEBSITE_ID=
# Origen del servidor Umami, sense /api/send ni barra final. Només https://
# (o http://localhost per a proves). Ex.: https://compta.example.org
VITE_UMAMI_HOST=
# Enllaç públic de compartir del tauler d'Umami (https://). Si hi és, /legal
# el mostra en un iframe aïllat; si no, diu que encara no està endollat.
VITE_UMAMI_SHARE_URL=

# ======= IAIA MARIA (BOT) =======
GEMINI_API_KEY=your-gemini-key
FAL_KEY=your-fal-ai-key
IAIA_DIRECTES=your-whatsapp-id
IAIA_GRUPS=cap

# ======= SOLLUTIA =======
VITE_SOLLUTIA_ISSUER=
VITE_CANONICAL_URL=https://socdepoble.org
VITE_TENANT_ID=default-tenant
IAIA_PROJECT_ROOT=./
IAIA_STATE_ROOT=./.iaia_state
IAIA_MODEL_TEXT=gemini-2.5-flash
IAIA_MAX_SESSIONS=300
IAIA_IMATGES_GOOGLE=false
IAIA_API_HOST=0.0.0.0
IAIA_CORS_ORIGIN=*
