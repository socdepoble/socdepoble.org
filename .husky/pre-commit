#!/bin/sh
# Hook de pre-commit de Sóc de Poble (Les Portes Mecàniques)

echo "🚪 Executant Portes Mecàniques (Husky)..."

npm run gate
if [ $? -ne 0 ]; then
  echo "❌ El codi no passa les portes mecàniques. Commit avortat."
  exit 1
fi

npm run lint
if [ $? -ne 0 ]; then
  echo "❌ El linter ha fallat. Commit avortat."
  exit 1
fi

npm run test -- --run
if [ $? -ne 0 ]; then
  echo "❌ Els tests unitaris han fallat. Commit avortat."
  exit 1
fi

echo "✅ Portes superades. Endavant."
exit 0
