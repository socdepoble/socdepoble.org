{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "socdepoble/app",
	"version": "0.2.0",
	"title": "Sóc de Poble",
	"category": "embed",
	"icon": "groups",
	"description": "Embeds the Sóc de Poble app with the universal host markup.",
	"keywords": [ "socdepoble", "poble", "village", "community" ],
	"textdomain": "socdepoble",
	"attributes": {
		"nomPoble": {
			"type": "string",
			"default": ""
		},
		"poble": {
			"type": "string",
			"default": ""
		},
		"rutaInicial": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./editor.js",
	"render": "file:./render.php"
}
