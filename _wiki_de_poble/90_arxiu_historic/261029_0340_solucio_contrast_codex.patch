+/* QA-H03 (Mestre 261029) · Contrast del token real: 7:1 sense arredonir,
+   en tots els modes. El verd anterior és el control negatiu del llindar. */
+describe('QA-H03 · el verd de marca sobre blanc supera el llindar AAA de 7:1', () => {
+  test('la font única és el token de marca; els quatre modes conserven almenys 7:1', () => {
+    expect([...senseComentaris(TOKENS).matchAll(/--sdp-verd\s*:/g)]).toHaveLength(1);
+    for (const [mode, mapa] of Object.entries({ clar: CLAR, fosc: MAPA_FOSC, bancal: MAPA_BANCAL, bancalFosc: MAPA_BANCAL_FOSC })) {
+      const parell = { ...mapa, '--qa-blanc': '#ffffff' };
+      expect(contrast('--sdp-verd', '--qa-blanc', parell), mode).toBeGreaterThanOrEqual(7);
+    }
+  });
+
+  test('el color anterior no passa: 6,9965997583:1 és inferior a 7 encara que arredonit done 7,00', () => {
+    const parell = { '--qa-antic': /* ALLOW_RAW_COLOR */ '#0f672f', '--qa-blanc': '#ffffff' };
+    const ratio = contrast('--qa-antic', '--qa-blanc', parell);
+    expect(ratio).toBeLessThan(7);
+    expect(ratio).toBeCloseTo(6.996599758323873, 12);
+    expect(Number(ratio.toFixed(2))).toBe(7);
+  });
+});
