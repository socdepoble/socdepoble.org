+
+    const entitat = ambitDelFil({
+      id: FIL_DIRECTE,
+      tipus: 'directe',
+      org_id: '99999999-0000-4000-8000-000000000099',
+      altres: []
+    });
+    expect(entitat).toMatchObject({
+      xifrat: true,
+      obligatori: true,
