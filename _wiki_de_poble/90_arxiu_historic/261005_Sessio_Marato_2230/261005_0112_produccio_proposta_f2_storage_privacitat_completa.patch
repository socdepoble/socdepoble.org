+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+
+const m = vi.hoisted(() => ({ firma: vi.fn(), baixa: vi.fn(), puja: vi.fn(), publica: vi.fn() }));
+vi.mock('./config.js', () => ({ getClient: async () => ({ storage: { from: (bucket) => ({
+  createSignedUrl: (...args) => m.firma(bucket, ...args),
+  download: (...args) => m.baixa(bucket, ...args),
+  upload: (...args) => m.puja(bucket, ...args),
+  getPublicUrl: (...args) => m.publica(bucket, ...args)
+}) } }) }));
+vi.mock('./runtime.js', () => ({ getResolvedConfig: (config = {}) => config }));
+vi.mock('../identitat.js', () => ({ usuariDeSessio: () => null }));
+import { resolveAsset, promoteToPublic } from './storage.js';
+import { CODI_MITJANS } from '../errorsBackend.js';
+
+const UID = '11111111-1a1a-4000-8000-000000000001';
+const POBLE = '22222222-2b2b-4000-8000-000000000002';
+const PATH = `${POBLE}/${UID}/notes/document-privat.pdf`;
+const REF = `sdp-media://mitjans_privats/${PATH}`;
+const FITXER = new Blob(['pdf'], { type: 'application/pdf' });
+const CONFIG = { tenantId: POBLE };
+const errorPrivat = () => Object.assign(new Error(`Object ${PATH} rejected`), { status: 403, code: `unexpected:${PATH}`, statusCode: `private:${UID}`, details: { path: PATH, tenant: POBLE } });
+let avis;
+beforeEach(() => {
+  Object.values(m).forEach((fn) => fn.mockReset());
+  m.baixa.mockResolvedValue({ data: FITXER, error: null });
+  m.puja.mockResolvedValue({ data: { path: PATH }, error: null });
+  avis = vi.spyOn(console, 'warn').mockImplementation(() => {});
+});
+afterEach(() => { avis.mockRestore(); });
+
+const comprovaPrivacitat = (cru) => {
+  expect(avis).toHaveBeenCalledOnce();
+  const consola = JSON.stringify(avis.mock.calls);
+  for (const secret of [PATH, UID, POBLE, REF, cru.message, cru.code, cru.statusCode]) expect(consola).not.toContain(secret);
+  expect(avis.mock.calls[0]).toHaveLength(2);
+  expect(avis.mock.calls[0][1]).toEqual({ codi: CODI_MITJANS.SENSE_PERMIS, status: 403 });
+  expect(cru.details).toEqual({ path: PATH, tenant: POBLE });
+};
+
+describe('Storage · privacitat dels registres de mitjans privats', () => {
+  test('la URL firmada rebutjada conserva la ref sense registrar ruta ni resposta crua', async () => {
+    const cru = errorPrivat();
+    m.firma.mockResolvedValue({ data: null, error: cru });
+    expect(await resolveAsset(REF, CONFIG)).toBe(REF);
+    expect(m.firma).toHaveBeenCalledWith('mitjans_privats', PATH, 3600);
+    comprovaPrivacitat(cru);
+  });
+
+  test('la baixada rebutjada no promou ni registra dades privades', async () => {
+    const cru = errorPrivat();
+    m.baixa.mockResolvedValue({ data: null, error: cru });
+    expect(await promoteToPublic(REF, CONFIG)).toBe(REF);
+    expect(m.baixa).toHaveBeenCalledWith('mitjans_privats', PATH);
+    expect(m.puja).not.toHaveBeenCalled();
+    comprovaPrivacitat(cru);
+  });
+
+  test('la pujada rebutjada en promoure conserva l’original i no registra dades privades', async () => {
+    const cru = errorPrivat();
+    m.puja.mockResolvedValue({ data: null, error: cru });
+    expect(await promoteToPublic(REF, CONFIG)).toBe(REF);
+    expect(m.puja).toHaveBeenCalledWith('mitjans', PATH, FITXER);
+    comprovaPrivacitat(cru);
+  });
+
+  test('l’èxit de la firma conserva el TTL i no registra res', async () => {
+    const signada = 'https://media.invalid/signed/private?token=sintetic';
+    m.firma.mockResolvedValue({ data: { signedUrl: signada }, error: null });
+    expect(await resolveAsset(REF, CONFIG)).toBe(signada);
+    expect(m.firma).toHaveBeenCalledWith('mitjans_privats', PATH, 3600);
+    expect(avis).not.toHaveBeenCalled();
+  });
+
+  test('l’èxit de la promoció conserva la ruta i el fitxer, sense avisar', async () => {
+    expect(await promoteToPublic(REF, CONFIG)).toBe(`sdp-media://mitjans/${PATH}`);
+    expect(m.baixa).toHaveBeenCalledWith('mitjans_privats', PATH);
+    expect(m.puja).toHaveBeenCalledWith('mitjans', PATH, FITXER);
+    expect(avis).not.toHaveBeenCalled();
+  });
+});
+
+test.each(['baixa', 'puja'])('una excepció del SDK durant %s conserva la reserva sense imprimir el text cru', async (operacio) => {
+  const cru = errorPrivat();
+  m[operacio].mockRejectedValue(cru);
+  expect(await promoteToPublic(REF, CONFIG)).toBe(REF);
+  expect(avis).toHaveBeenCalledOnce();
+  expect(avis.mock.calls[0][1]).toEqual({ codi: CODI_MITJANS.DESCONEGUT, status: undefined });
+  const consola = JSON.stringify(avis.mock.calls);
+  for (const secret of [PATH, UID, POBLE, REF, cru.message]) expect(consola).not.toContain(secret);
+  expect(cru.details).toEqual({ path: PATH, tenant: POBLE });
+});
+
+test('una resposta amb estat fraccionari no es registra com un codi HTTP vàlid', async () => {
+  const cru = Object.assign(new Error(`Object ${PATH} rejected`), { status: 403.5, statusCode: '403.5' });
+  m.firma.mockResolvedValue({ data: null, error: cru });
+  expect(await resolveAsset(REF, CONFIG)).toBe(REF);
+  expect(avis.mock.calls[0][1]).toEqual({ codi: CODI_MITJANS.DESCONEGUT, status: undefined });
+  expect(JSON.stringify(avis.mock.calls)).not.toContain(PATH);
+});
