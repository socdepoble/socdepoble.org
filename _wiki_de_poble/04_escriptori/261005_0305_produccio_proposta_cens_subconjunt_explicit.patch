+// C4 · Un nucli explícit no afirma la mida del Consell complet.
+function comprovaCensText(t,text) {
+  const root=fs.mkdtempSync(path.join(os.tmpdir(),'sdp-cens-subconjunt-'));
+  t.after(()=>fs.rmSync(root,{recursive:true,force:true}));
+  const skill=path.join(root,'.agents/skills/core-consell-i-colmena');
+  fs.mkdirSync(skill,{recursive:true});
+  fs.copyFileSync(path.join(REPO,'.agents/consell.json'),path.join(root,'.agents/consell.json'));
+  fs.writeFileSync(path.join(skill,'SKILL.md'),'Font única: consell.json\n');
+  fs.writeFileSync(path.join(root,'.agents/cas.md'),text+'\n');
+  return spawnSync(process.execPath,[path.join(REPO,'tooling/gates/tractor-cens.mjs'),'--arrel',root],{encoding:'utf8'});
+}
+test('C4 · el nucli explícit de tres executors no substituïx el cens complet',t=>{
+  const result=comprovaCensText(t,'Funcionem com un autèntic nucli de 3 IAs (MarIA com a Directora i els executors tècnics).');
+  assert.equal(result.status,0,result.stdout+result.stderr);
+});
+test('C4 · el subconjunt explícit amb xifra en lletra no substituïx el cens',t=>{
+  const result=comprovaCensText(t,'Preparem un subgrup de nou models per a esta prova.');
+  assert.equal(result.status,0,result.stdout+result.stderr);
+});
+test('C4 · un recompte incomplet del Consell continua rebutjat',t=>{
+  for(const text of ['El Consell té 3 IAs.','El Consell té onze IAs.','El Consell és un nucli de 3 IAs.','La família electrònica reunix un subgrup de nou models.','Un nucli de 3 IAs treballa amb onze models.','Un subgrup de nou models revisa onze models.']) {
+    const result=comprovaCensText(t,text);
+    assert.equal(result.status,1,result.stdout+result.stderr);
+    assert.match(result.stdout,/C4 · Xifra contradictòria/);
+  }
+});
