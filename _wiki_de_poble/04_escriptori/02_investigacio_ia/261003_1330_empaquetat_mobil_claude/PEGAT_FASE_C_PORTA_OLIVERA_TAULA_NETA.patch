+++ b/tests/porta-olivera-taula-neta.test.mjs
@@ -0,0 +1,388 @@
+/** Proves de la taula neta de fase de la porta Olivera (261019, ordre del Mestre de les 21:26).
+ *
+ *  Fixen la fallada observada el 261019: en canviar de fase, els documents de torn ja
+ *  consumits es quedaven a l'Escriptori perquè la porta ix amb 0 quan són del mateix dia,
+ *  estan declarats a «## Activitat en curs» (ho fa `document.mjs create`) i els sosté 24 h
+ *  el rebut del seu torn. `--taula-neta` jutja per fase: la trinitat del pla més recent, el
+ *  que ha nascut després del pla i el que la fase ha adoptat pels seus Vincles. Cap rebut no
+ *  adopta (el pla d'un torn es pot tornar a vincular). `--convoca` només deixa la trinitat.
+ *  Totes les fixtures viuen a os.tmpdir(): cap prova toca l'Escriptori real.
+ */
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { avui, checkEscriptori, checkTaulaNeta, taulaDeFase } from '../tooling/gates/porta-olivera.mjs';
+import { checkLocal } from '../tooling/gates/hooks-local.mjs';
+import { SOURCES } from '../tooling/brain/context-local.mjs';
+
+const REPO = fileURLToPath(new URL('..', import.meta.url));
+const PORTA = fileURLToPath(new URL('../tooling/gates/porta-olivera.mjs', import.meta.url));
+const DESK = '_wiki_de_poble/04_escriptori';
+const ARXIU = '_wiki_de_poble/90_arxiu_historic';
+const TORNS = '.agents/runtime/turns';
+const DIA = avui();
+const FASE = `${DIA}_2115`;
+const PLA = `${FASE}_pla_implementacio_capacitor.md`;
+const PROMPT_C = `${FASE}_prompt_claude_capacitor.md`;
+const PROMPT_G = `${FASE}_prompt_gemini_botigues.md`;
+const SESSIO = `${DIA}_sublimacio_2115`;
+const sense = (nom) => nom.replace(/\.md$/, '');
+const arxiva = (...noms) => `node tooling/gates/porta-olivera.mjs --arxiva ${noms.map((n) => `--nom ${n}`).join(' ')} --sessio ${SESSIO}`;
+/** Els Vincles amb què naix un informe de `document.mjs create` (draft): només l'índex general i el de l'Escriptori. */
+const VINCLES_PLANTILLA = '## Vincles\n\n- [[00_index]]\n- [[00_index_escriptori]]';
+const vincles = (...refs) => `${VINCLES_PLANTILLA}\n${refs.map((r) => `- [[${r}]]`).join('\n')}`;
+
+function mas(t) {
+  const arrel = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'sdp-olivera-taula-neta-')));
+  fs.mkdirSync(path.join(arrel, DESK, '00_bandeja_d_entrada'), { recursive: true });
+  t.after(() => fs.rmSync(arrel, { recursive: true, force: true }));
+  return arrel;
+}
+const posa = (arrel, rel, text = '# prova\n') => {
+  fs.mkdirSync(path.dirname(path.join(arrel, rel)), { recursive: true });
+  fs.writeFileSync(path.join(arrel, rel), text);
+};
+const doc = (cos = '', reflex = null) => `---\ntype: informe\n${reflex ? `reflex: sdp:${reflex}\n` : ''}---\n# Document\n\n${cos}\n`;
+/** Taula amb els documents donats, tots declarats a «## Activitat en curs» (com fa document.mjs create). */
+function taula(arrel, docs, { motius = {} } = {}) {
+  for (const [nom, text] of Object.entries(docs)) posa(arrel, `${DESK}/${nom}`, text);
+  const linies = Object.keys(docs).map((nom) => `- [[${sense(nom)}]]${motius[nom] ? ` · ${motius[nom]}` : ''}`);
+  posa(arrel, `${DESK}/00_index_escriptori.md`, `# Índex\n\n## Activitat en curs\n\n${linies.join('\n')}\n`);
+}
+const trinitat = () => ({ [PLA]: doc(VINCLES_PLANTILLA), [PROMPT_C]: doc(vincles(sense(PLA))), [PROMPT_G]: doc(VINCLES_PLANTILLA) });
+/**
+ * Registre de torn mínim que lligen la porta (estatTorn, rebutDe) i el reflex d'un rebut seu:
+ * obert 24 h, amb pla vinculat o no. Amb `fitxer`, el rebut és al registre i és d'eixe
+ * document (creació consolidada, o en l'estat `creacio`); sense, el rebut no hi és.
+ */
+function torn(arrel, { pla = null, fitxer = null, creacio = 'committed' } = {}) {
+  const id = `torn_${randomUUID()}`;
+  const rebut = randomUUID();
+  const ara = new Date().toISOString();
+  const receipts = fitxer ? { [rebut]: { id: rebut, route: 'auditoria', file: `${DESK}/${fitxer}`, creation: { state: creacio, preparedAt: ara, ...(creacio === 'committed' && { committedAt: ara, documentHash: 'a'.repeat(64) }) } } } : {};
+  posa(arrel, `${TORNS}/${id}.json`, JSON.stringify({ schema: 'sdp.turn.v1', turn_id: id, state: 'context_loaded', createdAt: ara, expiresAt: new Date(Date.now() + 86400000).toISOString(), receipts, plan: pla ? { file: `${DESK}/${pla}`, hash: 'x' } : null }));
+  return `${id}:${rebut}`;
+}
+const porta = (arrel, args) => spawnSync(process.execPath, [PORTA, ...args], { cwd: arrel, env: { ...process.env, SDP_ARREL: arrel }, encoding: 'utf8', timeout: 10000 });
+const instantania = (arrel) => fs.readdirSync(path.join(arrel, DESK)).sort().map((n) => [n, fs.statSync(path.join(arrel, DESK, n)).isFile() ? fs.readFileSync(path.join(arrel, DESK, n), 'utf8') : '<dir>']);
+const motius = (r) => Object.fromEntries([...r.dins, ...r.fora].map((d) => [d.nom, d.motiu]));
+const ordresDe = (stdout) => stdout.split('\n').map((l) => l.trim()).filter((l) => l.startsWith('node tooling/gates/porta-olivera.mjs --arxiva ') && !l.includes(' --sec '));
+
+test('[diagnosi 261019] un informe consumit d’una fase anterior del mateix dia, declarat, retingut i amb rebut obert, passa la porta però no la taula neta', (t) => {
+  const arrel = mas(t);
+  const vell = `${DIA}_1700_auditoria_fase_b.md`;
+  taula(arrel, { ...trinitat(), [vell]: doc(VINCLES_PLANTILLA, torn(arrel)) }, { motius: { [vell]: `Mestre ${DIA}: referència de la fase B` } });
+
+  const olivera = checkEscriptori(arrel);
+  assert.equal(olivera.valid, true, 'la porta de sempre jutja per jornada: el document d’avui hi passa');
+  assert.equal(olivera.convocatoria.vida.find((v) => v.nom === vell)?.valid, true, 'i la convocatòria v4 el veu viu (retenció i rebut)');
+
+  const r = checkTaulaNeta(arrel);
+  assert.equal(r.valid, false);
+  assert.equal(r.taula.fase, FASE);
+  assert.deepEqual(r.taula.fora.map((d) => d.nom), [vell]);
+  assert.match(r.taula.fora[0].motiu, new RegExp(`^nascut a ${DIA}_1700, abans de la fase ${FASE}, i els seus Vincles no citen el pla ni cap prompt de la fase \\(el seu rebut no acredita res: el rebut no és al registre de torn_`));
+  assert.equal(r.taula.fora[0].declarat, true);
+  assert.equal(r.taula.fora[0].tornObert, null, 'un rebut que el registre no coneix no acredita cap torn obert');
+  assert.equal(r.taula.fora[0].ordre, arxiva(vell));
+  assert.match(r.errors.join('\n'), new RegExp(`Fora de la fase ${FASE}: ${vell}`));
+});
+
+test('la trinitat sola (pla i prompts amb el mateix segell) és una taula neta i apta per a convocar, i la CLI ho diu amb 0', (t) => {
+  const arrel = mas(t);
+  taula(arrel, trinitat());
+  const r = taulaDeFase(arrel);
+  assert.equal(r.valid, true);
+  assert.deepEqual(r.pla, [PLA]);
+  assert.deepEqual(r.dins.map((d) => d.nom).sort(), [PLA, PROMPT_C, PROMPT_G].sort());
+  assert.equal(r.dins.every((d) => d.trinitat), true);
+  assert.deepEqual(r.ordres, []);
+  const cli = porta(arrel, ['--taula-neta']);
+  assert.equal(cli.status, 0, cli.stdout + cli.stderr);
+  assert.match(cli.stdout, new RegExp(`Fase en curs: ${FASE} \\(pla: ${PLA}\\)`));
+  assert.match(cli.stdout, new RegExp(`✅ Taula neta de fase: 3 document\\(s\\) de la fase ${FASE} \\(1 pla, 2 prompt\\(s\\) o bundle\\(s\\), 0 rèplica/ques, 0 adoptat\\(s\\)\\)`));
+  const convoca = porta(arrel, ['--taula-neta', '--convoca']);
+  assert.equal(convoca.status, 0, convoca.stdout + convoca.stderr);
+  assert.match(convoca.stdout, new RegExp(`✅ Taula a punt per a convocar: només la trinitat de la fase ${FASE} \\(1 pla, 2 prompt\\(s\\) o bundle\\(s\\)\\)`));
+});
+
+test('cap fals positiu: un informe nascut després del pla amb els Vincles de la plantilla és de la fase, i la CLI no proposa arxivar-lo', (t) => {
+  const arrel = mas(t);
+  const claude = `${DIA}_2155_auditoria_claude_capacitor.md`;
+  const gemini = `${DIA}_2145_auditoria_gemini_botigues.md`;
+  const mateixSegell = `${FASE}_auditoria_codex_inicial.md`;
+  taula(arrel, {
+    ...trinitat(),
+    [claude]: doc(VINCLES_PLANTILLA, torn(arrel, { fitxer: claude })),
+    [gemini]: doc(vincles(sense(PLA), `${sense(PROMPT_G)}|prompt de Gemini`)),
+    [mateixSegell]: doc(VINCLES_PLANTILLA),
+  });
+  const r = taulaDeFase(arrel);
+  assert.equal(r.valid, true, JSON.stringify(r.fora));
+  const m = motius(r);
+  assert.equal(m[claude], `rèplica: nascut a ${DIA}_2155, després del pla de la fase`);
+  assert.equal(m[gemini], `rèplica: nascut a ${DIA}_2145, després del pla de la fase`);
+  assert.equal(m[mateixSegell], `rèplica: nascut a ${FASE}, amb el pla de la fase, però «auditoria» no és pla ni prompt`);
+  const cli = porta(arrel, ['--taula-neta']);
+  assert.equal(cli.status, 0, cli.stdout + cli.stderr);
+  assert.doesNotMatch(cli.stdout, /--arxiva/);
+  assert.match(cli.stdout, /3 rèplica\/ques, 0 adoptat\(s\)/);
+});
+
+test('un document anterior al pla hi entra adoptat pels seus Vincles; una menció al cos, en una altra secció, en un comentari o en codi no l’adopta', (t) => {
+  const arrel = mas(t);
+  const adoptat = `${DIA}_2100_auditoria_claude_en_curs.md`;
+  const perPrompt = `${DIA}_2050_informe_gemini_previ.md`;
+  const crlf = `${DIA}_2055_auditoria_codex_crlf.md`;
+  const alCos = `${DIA}_2000_auditoria_esmenta_el_pla.md`;
+  const altraSeccio = `${DIA}_2010_auditoria_annex.md`;
+  const codi = `${DIA}_2020_auditoria_en_codi.md`;
+  taula(arrel, {
+    ...trinitat(),
+    [adoptat]: doc(vincles(sense(PLA))),
+    [perPrompt]: doc(vincles(`${DESK}/${sense(PROMPT_G)}|el prompt de Gemini`)),
+    [crlf]: doc(vincles(sense(PLA))).replace(/\n/g, '\r\n'),
+    [alCos]: doc(`Respon a [[${sense(PLA)}]] i a [[${sense(PROMPT_C)}]].\n\n${VINCLES_PLANTILLA}`),
+    [altraSeccio]: doc(`${VINCLES_PLANTILLA}\n\n## Annex\n\n- [[${sense(PLA)}]]`),
+    [codi]: doc(`## Vincles\n\n- \`[[${sense(PLA)}]]\`\n<!-- - [[${sense(PROMPT_C)}]] -->\n\`\`\`\n- [[${sense(PLA)}]]\n\`\`\``),
+  });
+  const r = taulaDeFase(arrel);
+  const m = motius(r);
+  assert.equal(m[adoptat], `adoptat: nascut a ${DIA}_2100, abans de la fase, i els seus Vincles citen [[${sense(PLA)}]]`);
+  assert.equal(m[perPrompt], `adoptat: nascut a ${DIA}_2050, abans de la fase, i els seus Vincles citen [[${sense(PROMPT_G)}]]`);
+  assert.equal(m[crlf], `adoptat: nascut a ${DIA}_2055, abans de la fase, i els seus Vincles citen [[${sense(PLA)}]]`, 'també amb salts de línia CRLF');
+  assert.deepEqual(r.fora.map((d) => d.nom), [alCos, altraSeccio, codi]);
+  const base = (s) => `nascut a ${DIA}_${s}, abans de la fase ${FASE}, i els seus Vincles no citen el pla ni cap prompt de la fase`;
+  assert.equal(m[alCos], `${base('2000')} (esmenta [[${sense(PLA)}]] fora de «## Vincles», i només compten els Vincles)`);
+  assert.equal(m[altraSeccio], `${base('2010')} (esmenta [[${sense(PLA)}]] fora de «## Vincles», i només compten els Vincles)`);
+  assert.equal(m[codi], base('2020'), 'comentaris i codi no citen res, ni dins ni fora dels Vincles');
+  const cli = porta(arrel, ['--taula-neta']);
+  assert.equal(cli.status, 1, cli.stdout + cli.stderr);
+  assert.match(cli.stdout, new RegExp(`✅ ${sense(adoptat)} ← adoptat: nascut a ${DIA}_2100`));
+  assert.match(cli.stdout, new RegExp(`❌ Taula bruta per a agents nous: 3 document\\(s\\) fora de la fase ${FASE}`));
+});
+
+test('un document anterior al pla sense Vincles a la fase cau, amb l’ordre --arxiva --nom exacta', (t) => {
+  const arrel = mas(t);
+  const vell = `${DIA}_1900_auditoria_fase_b.md`;
+  taula(arrel, { ...trinitat(), [vell]: doc(VINCLES_PLANTILLA) });
+  const r = taulaDeFase(arrel);
+  assert.equal(r.valid, false);
+  assert.deepEqual(r.fora.map((d) => [d.nom, d.motiu, d.ordre]), [[vell, `nascut a ${DIA}_1900, abans de la fase ${FASE}, i els seus Vincles no citen el pla ni cap prompt de la fase`, arxiva(vell)]]);
+  assert.deepEqual(r.ordres, [arxiva(vell).replace(' --arxiva ', ' --arxiva --sec '), arxiva(vell)]);
+  const cli = porta(arrel, ['--taula-neta']);
+  assert.equal(cli.status, 1, cli.stdout + cli.stderr);
+  assert.ok(cli.stdout.split('\n').map((l) => l.trim()).includes(arxiva(vell)), cli.stdout);
+});
+
+test('--convoca: només la trinitat; una rèplica, un adoptat o un document amb el segell que no és pla ni prompt ixen amb la seua ordre', (t) => {
+  const arrel = mas(t);
+  const replica = `${DIA}_2155_auditoria_claude_capacitor.md`;
+  const adoptat = `${DIA}_2100_auditoria_claude_previa.md`;
+  const mateixSegell = `${FASE}_auditoria_codex_inicial.md`;
+  const bundle = `${FASE}_bundle_consell_botigues.md`;
+  taula(arrel, {
+    ...trinitat(),
+    [bundle]: doc(),
+    [replica]: doc(VINCLES_PLANTILLA, torn(arrel, { fitxer: replica })),
+    [adoptat]: doc(vincles(sense(PLA))),
+    [mateixSegell]: doc(VINCLES_PLANTILLA),
+  });
+  assert.equal(taulaDeFase(arrel).valid, true, 'en la fase de treball, tots són de la fase');
+
+  const r = taulaDeFase(arrel, { convoca: true });
+  assert.equal(r.valid, false);
+  assert.deepEqual(r.dins.map((d) => d.nom).sort(), [PLA, PROMPT_C, PROMPT_G, bundle].sort(), 'el bundle d’un prompt del Consell comparteix l’hora (AGENTS §6)');
+  assert.deepEqual(r.fora.map((d) => d.nom), [adoptat, mateixSegell, replica]);
+  const fora = Object.fromEntries(r.fora.map((d) => [d.nom, d]));
+  const convocar = `; en convocar, la taula només té la trinitat ${FASE} (el pla i els seus prompts)`;
+  assert.equal(fora[replica].motiu, `rèplica: nascut a ${DIA}_2155, després del pla de la fase${convocar}`);
+  assert.equal(fora[adoptat].motiu, `adoptat: nascut a ${DIA}_2100, abans de la fase, i els seus Vincles citen [[${sense(PLA)}]]${convocar}`);
+  assert.equal(fora[mateixSegell].motiu, `rèplica: nascut a ${FASE}, amb el pla de la fase, però «auditoria» no és pla ni prompt${convocar}`);
+  for (const nom of [adoptat, mateixSegell, replica]) assert.equal(fora[nom].ordre, arxiva(nom));
+  assert.match(fora[replica].tornObert?.torn ?? '', /^torn_/, 'Acte Reflex: el torn del seu rebut és obert');
+  assert.equal(fora[adoptat].tornObert, null);
+
+  const cli = porta(arrel, ['--taula-neta', '--convoca']);
+  assert.equal(cli.status, 1, cli.stdout + cli.stderr);
+  assert.match(cli.stdout, new RegExp(`❌ Taula no apta per a convocar: 3 document\\(s\\) fora de la trinitat ${FASE}`));
+  assert.match(cli.stdout, /⚠️ El torn del seu rebut, torn_[0-9a-f]{8}, és obert fins a .*: Acte Reflex Pre-Arxivament abans d'arxivar-lo\./);
+  const ordres = ordresDe(cli.stdout);
+  assert.deepEqual(ordres.slice(0, 3), [adoptat, mateixSegell, replica].map((n) => arxiva(n)));
+  const fet = porta(arrel, ordres.at(-1).split(' ').slice(2));
+  assert.equal(fet.status, 0, fet.stdout + fet.stderr);
+  const net = porta(arrel, ['--taula-neta', '--convoca']);
+  assert.equal(net.status, 0, net.stdout + net.stderr);
+
+  const buida = mas(t);
+  taula(buida, {});
+  assert.equal(taulaDeFase(buida).valid, true, 'sense pla, la taula buida és neta');
+  assert.match(taulaDeFase(buida, { convoca: true }).errors.join('\n'), /Cap Pla d'Implementació a la taula: la convocatòria naix amb el seu pla/);
+});
+
+test('cap rebut fa pertànyer: ni el vàlid d’un torn que ha vinculat el pla de la fase (el pla del torn es pot tornar a vincular), ni un de copiat, inventat o sense consolidar', (t) => {
+  const arrel = mas(t);
+  const lligat = `${DIA}_2030_auditoria_lligada.md`;
+  const copiat = `${DIA}_2035_auditoria_copiada.md`;
+  const inventat = `${DIA}_2040_auditoria_inventada.md`;
+  const senseConsolidar = `${DIA}_2042_auditoria_a_mitges.md`;
+  const sensePla = `${DIA}_2045_auditoria_sense_pla.md`;
+  const reflex = torn(arrel, { pla: PLA, fitxer: lligat });
+  const tornId = reflex.split(':')[0];
+  taula(arrel, {
+    ...trinitat(),
+    [lligat]: doc(VINCLES_PLANTILLA, reflex),
+    [copiat]: doc(VINCLES_PLANTILLA, reflex),
+    [inventat]: doc(VINCLES_PLANTILLA, `${tornId}:${randomUUID()}`),
+    [senseConsolidar]: doc(VINCLES_PLANTILLA, torn(arrel, { pla: PLA, fitxer: senseConsolidar, creacio: 'prepared' })),
+    [sensePla]: doc(VINCLES_PLANTILLA, torn(arrel, { fitxer: sensePla })),
+  });
+  const r = taulaDeFase(arrel);
+  const m = motius(r);
+  const curt = tornId.slice(0, 13);
+  /* Regressió trobada en la verificació (261020): `turn.plan` és un camp únic que bindPlan
+     sobreescriu. Un torn que va crear documents en una fase anterior i després vincula el
+     pla nou faria passar el pla vell, els seus prompts i els seus informes. */
+  assert.deepEqual(r.fora.map((d) => d.nom), [lligat, copiat, inventat, senseConsolidar, sensePla]);
+  const base = (s) => `nascut a ${DIA}_${s}, abans de la fase ${FASE}, i els seus Vincles no citen el pla ni cap prompt de la fase`;
+  assert.equal(m[lligat], base('2030'), 'el rebut vàlid d’un torn amb el pla vinculat no adopta');
+  assert.equal(m[copiat], `${base('2035')} (el seu rebut no acredita res: el rebut de ${curt} és de ${DESK}/${lligat})`);
+  assert.equal(m[inventat], `${base('2040')} (el seu rebut no acredita res: el rebut no és al registre de ${curt})`);
+  assert.match(m[senseConsolidar], /\(el seu rebut no acredita res: el rebut de torn_[0-9a-f]{8} és d'una creació sense consolidar\)$/);
+  assert.equal(m[sensePla], base('2045'), 'un rebut vàlid d’un torn sense pla vinculat no adopta ningú');
+  const fora = Object.fromEntries(r.fora.map((d) => [d.nom, d]));
+  assert.match(fora[lligat].tornObert?.torn ?? '', /^torn_/, 'el rebut vàlid només acredita el torn obert: Acte Reflex abans d’arxivar');
+  assert.equal(fora[copiat].tornObert, null, 'un reflex copiat tampoc acredita el torn obert de l’altre');
+  assert.equal(fora[inventat].tornObert, null);
+  assert.match(fora[sensePla].tornObert?.torn ?? '', /^torn_/);
+});
+
+test('un pla nou fa fase nova: el pla vell, el seu prompt i les seues rèpliques ixen amb una sola ordre agrupada', (t) => {
+  const arrel = mas(t);
+  const plaVell = `${DIA}_1530_pla_implementacio_webp.md`;
+  const promptVell = `${DIA}_1530_prompt_claude_webp.md`;
+  const replicaVella = `${DIA}_1600_auditoria_claude_webp.md`;
+  taula(arrel, { ...trinitat(), [plaVell]: doc(), [promptVell]: doc(), [replicaVella]: doc(vincles(sense(plaVell))) });
+  const r = taulaDeFase(arrel);
+  assert.equal(r.fase, FASE, 'la fase en curs és la del pla més recent');
+  assert.equal(r.seguent, null);
+  assert.deepEqual(r.fora.map((d) => d.nom), [plaVell, promptVell, replicaVella]);
+  const noms = `--nom ${plaVell} --nom ${promptVell} --nom ${replicaVella}`;
+  assert.deepEqual(r.ordres, [
+    `node tooling/gates/porta-olivera.mjs --arxiva --sec ${noms} --sessio ${SESSIO}`,
