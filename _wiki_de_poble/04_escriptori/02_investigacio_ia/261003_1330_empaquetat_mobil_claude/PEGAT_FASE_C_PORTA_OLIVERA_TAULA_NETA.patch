+/* ── Taula neta de fase (261019, ordre del Mestre de les 21:26) ───────────── */
+
+/** Segell d'una fase: el `aammdd_hhmm` del Pla d'Implementació que la convoca. */
+const SEGELL_FASE = /^\d{6}_\d{4}$/;
+const segellDe = (d) => `${d.data}_${d.hora}`;
+const esPla = (d) => /^pla_implementacio(?:_|$)/.test(d.resta);
+/** El que es convoca amb el pla i porta el seu segell: els prompts i, per al Consell, el bundle de cada prompt (AGENTS §6). */
+const CONVOCATS = /^(prompt|macro_prompt|micro_prompt|petorreta|bundle|macro_bundle|micro_bundle)$/;
+/** Capçalera Markdown, amb la tancada opcional: la mateixa lectura que la porta de frontmatter (validaVincles). */
+const CAPCALERA = /^ {0,3}(#{1,6})[\t ]+(.+?)(?:[\t ]+#+)?[\t ]*$/;
+
+/**
+ * Documents del primer nivell que un Markdown cita amb `[[…]]`, en dos grups: `vincles`, els de
+ * les seues seccions «## Vincles» (cada secció acaba a la capçalera següent de nivell 1 o 2), i
+ * `cos`, els de la resta del text, que només els esmenta. El frontmatter no compta, i els
+ * comentaris i el codi tampoc, com a l'índex (prosaIndex).
+ */
+function citesDe(abs, presents) {
+  const vincles = new Set();
+  const cos = new Set();
+  const text = llegeixSiPots(abs);
+  if (typeof text !== 'string') return { vincles, cos };
+  const fm = /^---\r?\n[\s\S]*?\r?\n---[ \t]*(?:\r?\n|$)/.exec(text);
+  let dins = false;
+  for (const linia of prosaIndex(fm ? text.slice(fm[0].length) : text).split(/\r?\n/)) {
+    const h = CAPCALERA.exec(linia);
+    if (h && h[1].length <= 2) { dins = h[1].length === 2 && h[2] === 'Vincles'; continue; }
+    for (const a of linia.matchAll(ANCORA)) {
+      const nom = resolAncora(a[2], presents);
+      if (nom) (dins ? vincles : cos).add(nom);
+    }
+  }
+  return { vincles, cos };
+}
+
+/**
+ * Rebut del frontmatter d'un document solt, validat contra el registre del seu torn: compta
+ * només si el registre és vàlid, el rebut hi és amb el mateix id, el seu `file` és este
+ * document i, si naix amb fase de creació, està consolidat (les guardes de `relleu`). Un
+ * `reflex` copiat d'un altre document o inventat no acredita res. No mira si el torn és obert:
+ * el rebut diu d'on ve el document; qui el necessita ho diu la convocatòria v4 (vidaDe).
+ */
+function rebutDe(arrel, rel) {
+  const reflex = reflexDe(path.join(arrel, rel));
+  if (!reflex) return null;
+  let registre;
+  try { registre = JSON.parse(fs.readFileSync(path.join(arrel, TORNS, `${reflex.torn}.json`), 'utf8')); }
+  catch { return { ...reflex, valid: false, motiu: `el registre de ${curt(reflex.torn)} no és a ${TORNS}/` }; }
+  const rebut = registre?.receipts?.[reflex.rebut];
+  const motiu = registre?.turn_id !== reflex.torn || registre.schema !== 'sdp.turn.v1' ? `el registre de ${curt(reflex.torn)} no és vàlid`
+    : rebut?.id !== reflex.rebut || typeof rebut.file !== 'string' ? `el rebut no és al registre de ${curt(reflex.torn)}`
+      : rebut.file !== rel ? `el rebut de ${curt(reflex.torn)} és de ${rebut.file}`
+        : Object.hasOwn(rebut, 'creation') && rebut.creation?.state !== 'committed' ? `el rebut de ${curt(reflex.torn)} és d'una creació sense consolidar`
