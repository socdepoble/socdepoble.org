{
  "hosting": {
    "site": "soc-de-poble",
    "public": "dist",
    "ignore": [
      "**/.*",
      "!.well-known",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      {
        "regex": "^/\\.well-known/webfinger/(?i:acct(?::|%3a)socdepoble(?:@|%40)socdepoble\\.org)$",
        "destination": "/.well-known/webfinger/socdepoble.json"
      },
      {
        "regex": "^/\\.well-known/webfinger/(?i:acct(?::|%3a)la-torre-de-les-macanes(?:@|%40)socdepoble\\.org)$",
        "destination": "/.well-known/webfinger/la-torre-de-les-macanes.json"
      },
      {
        "regex": "^/\\.well-known/webfinger/(?i:acct(?::|%3a)latorredelesmacanes(?:@|%40)socdepoble\\.org)$",
        "destination": "/.well-known/webfinger/la-torre-de-les-macanes.json"
      },
      {
        "source": "!/@(assets|fonts|ap|.well-known)/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self'; worker-src 'self' blob:; connect-src 'self' data: https: wss: ws://localhost:* http://localhost:*; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' https: data:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://*.socdepoble.org https://socdepoble.org https://*.sollutia.cat https://sollutia.cat https://*.sollutia.com http://localhost:*;"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=(self)"
          }
        ]
      },
      {
        "source": "!/@(assets|fonts)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Expose-Headers",
            "value": "Content-Range, ETag"
          },
          {
            "key": "Access-Control-Allow-Headers",
            "value": "Range"
          }
        ]
      },
      {
        "regex": "^/assets/[^/]+-[A-Za-z0-9_-]{8}\\.(js|mjs|css|woff2?)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/.well-known/host-meta",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xrd+xml; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "regex": "^/\\.well-known/webfinger(?:/.*)?$",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "regex": "^/\\.well-known/webfinger/(?:(?:socdepoble|la-torre-de-les-macanes)\\.json|(?i:acct(?::|%3a)(?:socdepoble|la-torre-de-les-macanes|latorredelesmacanes)(?:@|%40)socdepoble\\.org))$",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/jrd+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "/ap/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/activity+json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
