{
  "appId": "org.socdepoble.app",
  "appName": "Sóc de Poble",
  "webDir": "dist-natiu",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "hostname": "localhost"
  },
  "android": {
    "minWebViewVersion": 100,
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "CapacitorCookies": {
      "enabled": false
    }
  }
}
